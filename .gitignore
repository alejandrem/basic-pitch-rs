# Referencia de Python (repo oficial de Spotify, solo lectura)
/basic-pitch/

# Entorno Python de referencia (uv)
/.venv/

# Artefactos de compilacion de Rust
/target/

# Salidas temporales
*.mid

# ...pero las transcripciones del proyecto si se versionan: son pequenas
# y son el resultado del trabajo.
!transcripciones/*.mid

# Cache de Python
__pycache__/
*.py[cod]

# Material personal del usuario: el MIDI original y el audio renderizado
# de "peso del silencio" no se versionan. El audio pesa 30 MB y la cancion
# es del autor del proyecto.
reference/audio_reference/peso_del_silencio.wav
reference/notes/peso_del_silencio_notes.npy
reference/notes/peso_del_silencio_upstream.mid

# Audios de prueba del autor del proyecto: son material personal y el WAV
# renderizado pesa 29 MB.
amaris.mp3
amaris_transcrito.wav
transcripciones/*.mp3
transcripciones/*.wav
